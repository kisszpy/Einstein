# 后端开发环境变量模板，复制为 .env 后修改
APP_DEBUG=true

# llama.cpp OpenAI 兼容端点
APP_LLM_BASE_URL=http://localhost:8080/v1
APP_LLM_MODEL=qwen3.6-27b
APP_EMBEDDING_BASE_URL=http://localhost:8081/v1
APP_EMBEDDING_MODEL=qwen3-embedding-8b

# 存储
APP_POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/aiplatform
# 开发期可先用 milvus-lite 本地文件：./data/milvus_lite.db
APP_MILVUS_URI=http://localhost:19530
APP_MILVUS_COLLECTION=chunks
APP_REDIS_URL=redis://localhost:6379/0
