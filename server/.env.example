# 后端开发环境变量模板，复制为 .env 后修改
# 注意：debug=true 时 Starlette 会忽略自定义异常处理器并直接返回堆栈，线上必须为 false
APP_DEBUG=false

# 模型端点（OpenAI 兼容：llama.cpp / DeepSeek / 其他云端同接口）
APP_LLM_BASE_URL=http://localhost:8080/v1
APP_LLM_API_KEY=not-needed
APP_LLM_MODEL=qwen3.6-27b
APP_EMBEDDING_BASE_URL=http://localhost:8081/v1
APP_EMBEDDING_MODEL=qwen3-embedding-8b

# 存储后端开关
#   store  : postgres（生产，默认）| sqlite（单机事务）| json（零依赖起步）
#   vector : milvus（生产，默认）| memory（numpy 暴力检索）
#   queue  : redis（生产，默认）| local（进程内 + asyncio）
#
# 默认走生产组合：需要下面 postgres / redis / milvus 三个连接串可达，
# 起依赖用 `cd deploy && docker compose up -d`（端口映射见文件末尾说明）。
APP_STORE_BACKEND=postgres
APP_VECTOR_BACKEND=milvus
APP_QUEUE_BACKEND=redis

# 零依赖起步（不装任何数据库，数据落在 data/ 下的 json 文件）：
# 把上面三行注释掉，改用下面三行
# APP_STORE_BACKEND=json
# APP_VECTOR_BACKEND=memory
# APP_QUEUE_BACKEND=local

# 对应后端连接串（只有把上面的开关切过去才会被读取）
# sqlite 文件路径（store=sqlite 时生效）
APP_SQLITE_PATH=data/einstein.db
# 端口 5433/6380 为 deploy/docker-compose.yml 的映射，避免与本机已有服务冲突
APP_POSTGRES_DSN=postgresql://einstein:einstein@127.0.0.1:5433/einstein
APP_MILVUS_URI=http://127.0.0.1:19530
APP_MILVUS_COLLECTION=einstein_chunks
APP_REDIS_URL=redis://127.0.0.1:6380/0

# 批量导入
# 单批文件数与累计大小上限：0 = 不限制（整目录一次导入）。
# 公网部署建议设个上限（如 2000 / 4096）防 zip 炸弹；内网自用留 0 即可。
APP_IMPORT_BATCH_MAX_FILES=0
APP_IMPORT_BATCH_MAX_MB=0
# 每 N 个文件切一个队列任务。一个任务只被一个 worker 槽消费，
# 所以大批量导入要配合 worker 并发数（--concurrency）才跑得满。
APP_IMPORT_BATCH_SHARD=50
# 服务端目录导入：等于允许服务读取本机文件，默认关闭（留空=禁用）。
# 需要「直接吃本机某个目录」时，填逗号分隔的绝对路径白名单，只允许读这些目录下的文件。
# 例：APP_LOCAL_IMPORT_ROOTS=D:\docs\产品手册,E:\knowledge
APP_LOCAL_IMPORT_ROOTS=

# GitHub（技能动态安装与技能市场）
# 留空为匿名访问：核心接口 60 次/小时、搜索 10 次/分钟，容易限流。
# 建议填入只读 token（不需要任何 scope），额度提升到 5000 次/小时。
APP_GITHUB_TOKEN=
# 市场浏览的 GitHub topic，逗号分隔
APP_SKILL_MARKET_TOPICS=agent-skills
# 自建技能市场索引（JSON 数组），逗号分隔；格式见 docs/skill-market.md
APP_SKILL_MARKET_REGISTRY_URLS=

# 智能体工作能力
# 代码执行：子进程跑 Python/Node/Java/Maven，工作目录锁定在项目内。涉密环境可关闭。
# 容器默认断网（--network none），所以 pip/npm 装不了包、Maven 只能吃本地仓库，
# 三套工具链必须预装进镜像：docker build -t einstein-code-sandbox:latest \
#   -f docker/code-sandbox.Dockerfile docker
APP_AGENT_CODE_EXEC=true
# 执行环境：auto（配了云沙箱就走云，否则 docker，最后才看 ALLOW_HOST）
# | e2b（强制云沙箱）| container（强制容器）| host（强制宿主，不建议）
APP_AGENT_CODE_EXEC_SANDBOX=auto
APP_AGENT_CODE_EXEC_IMAGE=einstein-code-sandbox:latest
# 宿主 ~/.m2 路径：设了就把整个本地 Maven 仓库只读挂进容器，补齐镜像没预热的
# 依赖（容器断网，Maven 无法自行下载）。留空则只用镜像内置的离线仓库。
APP_AGENT_CODE_EXEC_M2_HOST=

# ---- 云沙箱（E2B 协议）：阿里云 Agent Sandbox 极速版 ----
# 填了 API Key 且 SANDBOX=auto 时会优先用云沙箱：VM 级隔离、可出网装包、
# 闲置休眠不计算力。三个连接参数都从控制台取，地域必须一致。
# 阿里云示例：API_URL=https://api.cn-beijing.sandbox.aliyuncs.com
#             DOMAIN=cn-beijing.sandbox.aliyuncs.com
# 注意：项目文件会同步到云端沙箱，涉密数据不要开。
APP_AGENT_CODE_EXEC_E2B_API_KEY=
APP_AGENT_CODE_EXEC_E2B_API_URL=
APP_AGENT_CODE_EXEC_E2B_DOMAIN=
# 官方模板 base / code-interpreter-v1（Python + Node + JDK 21）。Maven 由下面
# 两项在第一次 mvn 调用时按需安装（约 10MB，实测 1 秒内），装进会话、会话销毁
# 即消失，不必自己构建模板。要预装好再上线，也可用 docker/template/ 自定义模板。
APP_AGENT_CODE_EXEC_E2B_TEMPLATE=code-interpreter-v1
# 沙箱最长存活与空闲回收（秒）。按秒计费，闲置就是烧钱
APP_AGENT_CODE_EXEC_E2B_LIFETIME=900
APP_AGENT_CODE_EXEC_E2B_IDLE=300
APP_AGENT_CODE_EXEC_E2B_WORKDIR=/home/user/work
# 允许出网（装 pip/npm 包需要）。敏感场景设 false，改由模板预装依赖
APP_AGENT_CODE_EXEC_E2B_ALLOW_INTERNET=true
# 出口白名单（域名/IP/CIDR，逗号分隔）。填了就变成「默认拒绝 + 白名单」，
# 只放行包仓库比全开安全，例如：
#   pypi.org,files.pythonhosted.org,registry.npmjs.org,repo1.maven.org
APP_AGENT_CODE_EXEC_E2B_ALLOW_OUT=
# Maven 按需安装的来源包与中央仓库镜像。留空 URL 则关闭按需安装（maven 调用
# 直接报「模板缺 mvn」）。官方 repo1 在国内极慢，默认换阿里云镜像。
APP_AGENT_CODE_EXEC_E2B_MAVEN_URL=https://mirrors.aliyun.com/apache/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz
APP_AGENT_CODE_EXEC_E2B_MAVEN_MIRROR=https://maven.aliyun.com/repository/public
# 引擎：deepagents = 计划(write_todos) + 子智能体 + 上下文压缩 + 文件系统；
# deepagents-pro = 在 deep 之上多给真沙箱（execute，Docker 容器优先）与浏览器
#   （browser_open / browser_links / browser_shot）；
# react = 旧的单循环，仅用于回滚对比（事件协议一致，前端无感）。
APP_AGENT_ENGINE=deepagents
# ---- Pro 引擎的 shell 沙箱 ----
# auto = 有 docker 就用容器（项目目录挂到 /work，限内存/CPU/PID），否则降级宿主 shell；
# container = 只用容器（docker 不可用时报错降级）；local = 只用宿主 shell（无隔离）；
# off = 关闭 execute 工具
APP_AGENT_PRO_SANDBOX=auto
APP_AGENT_PRO_IMAGE=python:3.12-slim
# 容器网络：none 完全断网（默认，最安全）；bridge 可联网装包（容器能访问
# host.docker.internal，宿主上的 PG/Redis 也会暴露给模型写的代码，谨慎开启）
APP_AGENT_PRO_NETWORK=none
APP_AGENT_PRO_SHELL_TIMEOUT=60
APP_AGENT_PRO_MEMORY=1g
APP_AGENT_PRO_CPUS=2
# 容器内以哪个用户运行：1000:1000 = 非 root（推荐）；root = 不降权。
# Linux 上 bind mount 属主是宿主 uid，不匹配时工作目录不可写，引擎会自动
# 降级为 root 重试一次并打日志。想让非 root 长期可用，把宿主目录属主对齐。
APP_AGENT_PRO_RUN_AS=1000:1000
# 根文件系统只读（配合 /tmp、/run 的 tmpfs）。装依赖走 PIP_USER 落到工作区，
# 所以 pip install 仍然可用；只有"改镜像里的系统文件"会被拒绝。
APP_AGENT_PRO_READONLY_ROOT=1

# ---- 智能体流式与运行时 ----
# 真流式：模型边生成边下发，首字延迟从"全文生成完"降到"第一个 token"。
# 模型端点不支持 SSE 时设为 0，回到"生成完再按 24 字符切片"。
APP_AGENT_STREAM=1
# 无头浏览器空闲回收（秒）：常驻省掉每次 1-2 秒冷启动，空闲后释放内存
APP_BROWSER_IDLE_SECONDS=120

# ---- 人工确认（HITL）----
# 这些工具在执行前会暂停，等用户批准；批准后从断点续跑（已完成的步骤不重做）。
# 例：APP_AGENT_APPROVAL_TOOLS=code_run
APP_AGENT_APPROVAL_TOOLS=code_run
# 隔离沙箱（云沙箱 / 容器）里执行代码是否也要确认。默认 false：
# 这两类后端的文件系统独立、服务端密钥不在里面，跑任意代码不构成越权。
# 宿主进程执行（无隔离，能读 .env）永远确认，不受这一项影响。
# 只在「连隔离环境也要人工把关」的场景设 true。
APP_AGENT_APPROVAL_ISOLATED=false
# 单次批准的有效期（分钟）：过期视为未批准，宁可多问一次也不永久放行
APP_AGENT_APPROVAL_TTL_MINUTES=30
# 「本次会话都允许」的有效期（分钟）。语义是「这个对话里别再问我」，
# 所以给得比单次批准长——对话本身的寿命通常就是几小时。
APP_AGENT_APPROVAL_SESSION_TTL_MINUTES=480
# 短期记忆（LangGraph 线程状态）存哪：auto | sqlite | postgres | memory | off
# auto = 跟主存储走（APP_STORE_BACKEND=postgres 时用 postgres，其余用 sqlite）。
# 落盘之后服务重启也能从断点续跑；memory 只在进程内，重启即丢，仅供测试。
# 多副本/多 worker 部署必须用 postgres——sqlite 是单机的，而且每个进程各写各的。
APP_AGENT_CHECKPOINT=auto
# sqlite 档的位置；空 = data/checkpoints.db
APP_AGENT_CHECKPOINT_SQLITE_PATH=
# 检查点保留时长（小时）：超过这么久没更新的线程会被清理，0 = 不清理。
# 审批 TTL 只有 30 分钟，这里留 72 小时不会误删"待确认"的线程。
APP_AGENT_CHECKPOINT_TTL_HOURS=72

# ---- 检索 ----
# 相关性门限（余弦或重排分）：低于它的命中直接丢弃，"知识库未命中"才可达。
# 必须按你实际用的嵌入模型标定——日志会打印"最高 xx"，据此调。
# 0 = 关闭门限（不推荐：不相关文本也有 0.2~0.5 的相似度）
APP_RETRIEVAL_MIN_SCORE=0.35
# 同一文档最多贡献几个片段：防止一篇结构重复的文档占满名额
APP_RETRIEVAL_MAX_PER_DOC=2
# 嵌入分批：一次请求最多多少条 / 多少字符（整篇长文档塞一个请求必然超时）
APP_EMBEDDING_BATCH_SIZE=32
APP_EMBEDDING_BATCH_CHARS=40000
# 换嵌入模型（维度变了）之后，旧向量与新查询不在同一向量空间：检索会先比对
# 切片上记录的 model/dim，不一致直接给出提示。按提示重算：
#   python tools/rebuild_vector_index.py --reembed --drop

# ---- 重排序 ----
# auto（默认）= 配了端点走 http、配了模型目录走 onnx、都没有就关；
# none 关；http 走 OpenAI 兼容 /rerank；onnx 走本机 bge-reranker。
# 开与不开对召回率影响很大：换库或换嵌入模型之后，用「评测」页跑一次同一套
# 用例对比两次结果（`POST /api/eval/sets/{id}/run`）。
APP_RERANK_PROVIDER=auto
APP_RERANK_ENDPOINT=
APP_RERANK_MODEL=reranker
APP_RERANK_API_KEY=
APP_RERANK_MODEL_DIR=

# ---- 图片与扫描件 OCR ----
# 手机拍的合同、微信截图、没有文本层的 PDF：这些要先把图变成字才能入库检索。
#
# auto（默认）= 配了 APP_OCR_MODEL 就用视觉模型，否则看有没有装 pytesseract，
#               两者都没有时上传图片会直接报错并说明缺什么（不会入库空文档）。
# vision      = 只用 OpenAI 兼容的多模态端点
# tesseract   = 只用本地 tesseract（需 pip install pytesseract 并装语言包）
# off         = 关闭；上传图片会被拒
APP_OCR_PROVIDER=auto
# 留空 = 跟随 APP_LLM_BASE_URL / APP_LLM_API_KEY。视觉模型常单独起一个端口
# （文本 8080、视觉 8082），所以留了覆盖位。
APP_OCR_BASE_URL=
APP_OCR_API_KEY=
# 必须支持图片输入，例如 qwen2.5-vl-7b / gpt-4o-mini。空 = 不启用视觉档。
APP_OCR_MODEL=
APP_OCR_TIMEOUT=120
# 单图最多转录多少 token（约 4000 汉字）；超长合同请分页拍
APP_OCR_MAX_TOKENS=4096
# 长边缩到这个像素再发（视觉 token 随像素平方涨）；0 = 不缩
APP_OCR_MAX_SIDE=2000
# 扫描件最多 OCR 前 N 页：200 页的扫描件逐页识别要几十分钟，先做前 20 页并标注截断
APP_OCR_MAX_PAGES=20
# 仅 tesseract 用，需装对应语言包
APP_OCR_LANG=chi_sim+eng

# ---- 文档源同步 ----
# 网页入库的文档超过这么多天没重抓，就在列表里标"可能过期"。
# 只对记了 source_url 的文档生效——手工粘贴的正文没有"源"，不该被标红。
# 0 = 不提示。
APP_KB_STALE_DAYS=30

# ---- 告警 ----
# 后台评估间隔（分钟）：0 = 关闭定时评估，只留页面上的手动检查。
# 规则的 webhook 与阈值在「运营 → 告警」里配，不进环境变量（要按工作区区分）。
APP_ALERT_INTERVAL_MINUTES=10
