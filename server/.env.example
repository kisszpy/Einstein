# 后端开发环境变量模板，复制为 .env 后修改
# 注意：debug=true 时 Starlette 会忽略自定义异常处理器并直接返回堆栈，线上必须为 false
APP_DEBUG=false

# 模型端点（OpenAI 兼容：llama.cpp / DeepSeek / 其他云端同接口）
APP_LLM_BASE_URL=http://localhost:8080/v1
APP_LLM_API_KEY=not-needed
APP_LLM_MODEL=qwen3.6-27b
APP_EMBEDDING_BASE_URL=http://localhost:8081/v1
APP_EMBEDDING_MODEL=qwen3-embedding-8b

# 存储后端开关
#   store  : json（零依赖，v0.1 行为）| sqlite（单机事务）| postgres（生产）
#   vector : memory（numpy 暴力检索）| milvus（生产）
#   queue  : local（DB + asyncio worker）| redis
APP_STORE_BACKEND=json
APP_VECTOR_BACKEND=memory
APP_QUEUE_BACKEND=local

# 对应后端连接串（只有把上面的开关切过去才会被读取）
# sqlite 文件路径（store=sqlite 时生效）
APP_SQLITE_PATH=data/einstein.db
# 端口 5433/6380 为 deploy/docker-compose.yml 的映射，避免与本机已有服务冲突
APP_POSTGRES_DSN=postgresql://einstein:einstein@127.0.0.1:5433/einstein
APP_MILVUS_URI=http://127.0.0.1:19530
APP_MILVUS_COLLECTION=einstein_chunks
APP_REDIS_URL=redis://127.0.0.1:6380/0

# GitHub（技能动态安装与技能市场）
# 留空为匿名访问：核心接口 60 次/小时、搜索 10 次/分钟，容易限流。
# 建议填入只读 token（不需要任何 scope），额度提升到 5000 次/小时。
APP_GITHUB_TOKEN=
# 市场浏览的 GitHub topic，逗号分隔
APP_SKILL_MARKET_TOPICS=agent-skills
# 自建技能市场索引（JSON 数组），逗号分隔；格式见 docs/skill-market.md
APP_SKILL_MARKET_REGISTRY_URLS=

# 智能体工作能力
# 代码执行：子进程跑 Python/Node，工作目录锁定在项目内。涉密环境可关闭。
APP_AGENT_CODE_EXEC=true
