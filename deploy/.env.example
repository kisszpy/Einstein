# 复制为 deploy/.env 后按需修改；只有这几项是必须自己填的。
POSTGRES_PASSWORD=change-me-strong-password
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me-too

# 模型端点：宿主机上的 llama.cpp / vLLM / 云端 OpenAI 兼容服务
APP_LLM_BASE_URL=http://host.docker.internal:8080/v1
APP_LLM_API_KEY=not-needed
APP_LLM_MODEL=qwen3.6-27b
APP_EMBEDDING_BASE_URL=http://host.docker.internal:8081/v1
APP_EMBEDDING_MODEL=qwen3-embedding-8b

# 对外端口
WEB_PORT=80
BACKEND_PORT=8000
WORKER_CONCURRENCY=2
