# 复制为 deploy/.env 后按需修改；只有这几项是必须自己填的。
POSTGRES_PASSWORD=change-me-strong-password
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me-too

# LLM 等应用层配置（模型端点、密钥、云沙箱、SMTP…）统一来自 server/.env，
# compose 以 env_file 方式注入 backend/worker，本文件无需重复配置。
# 注意：server/.env 里指向 127.0.0.1 的基础设施地址（PG/Redis/Milvus）会被
# compose 的 x-backend-env 覆盖成容器网络地址，不用手工改。

# 嵌入服务跑在宿主机上，容器里 127.0.0.1 不通，必须走 host.docker.internal；
# 宿主机没起嵌入服务时嵌入自动降级 mock，检索质量下降但应用可用。
APP_EMBEDDING_BASE_URL=http://host.docker.internal:8180/v1
APP_EMBEDDING_MODEL=qwen3-embedding

# 对外端口
WEB_PORT=80
BACKEND_PORT=8000
WORKER_CONCURRENCY=2
