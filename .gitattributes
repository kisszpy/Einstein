# 换行：仓库里统一 LF，避免 shell / Dockerfile 被 Windows 检出成 CRLF 后跑不起来
* text=auto eol=lf

*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.py            text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.ico  binary
*.gz   binary
*.woff binary
*.woff2 binary
